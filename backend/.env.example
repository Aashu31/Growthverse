# GrowthVerse Backend Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Application
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
BACKEND_ORIGIN=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/growthverse_dev
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/growthverse_test

# Origins (comma-separated allowlist; credentials require exact origins)
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Token/session configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=GENERATE_A_64_CHARACTER_RANDOM_SECRET
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_MS=604800000
PASSWORD_RESET_EXPIRY_MS=1800000
EMAIL_VERIFICATION_EXPIRY_MS=86400000

# Cookies
# COOKIE_DOMAIN=.example.com
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_TIME=1 minute
LOGIN_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=20

# Email provider: console (dev only, does NOT deliver), smtp, none
EMAIL_PROVIDER=console
EMAIL_FROM=GrowthVerse <no-reply@growthverse.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Argon2id parameters
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# One-time SUPER_ADMIN provisioning (script-only; no public API)
ALLOW_SUPER_ADMIN_PROVISION=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FORCE=false

# Set true only when running behind a trusted reverse proxy
TRUST_PROXY=false
LOG_LEVEL=info
