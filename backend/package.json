{
  "name": "growthverse-backend",
  "version": "1.0.0",
  "description": "GrowthVerse Backend - Node.js Fastify + PostgreSQL + Prisma",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "node src/app.js",
    "start": "node src/app.js",
    "test": "node scripts/prepare-test-db.js && vitest run",
    "test:watch": "node scripts/prepare-test-db.js && vitest",
    "test:debug": "vitest run --debug",
    "smoke:auth": "node scripts/smoke-auth.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "admin:provision": "node scripts/provision-super-admin.js"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "nodejs",
    "api"
  ],
  "author": "GrowthVerse",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.31.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.1",
    "helmet": "^7.0.0",
    "joi": "^17.13.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.11.0",
    "prisma": "^5.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "vitest": "^2.0.5"
  }
}
